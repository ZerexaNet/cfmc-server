{
  "name": "cfmc-server",
  "version": "0.1.0",
  "description": "CFMC-Edge — 在 Cloudflare 全球边缘网络上运行的纯 Serverless Minecraft 服务器 (Workers + Durable Objects + D1)",
  "main": "src/index.js",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZerexaNet/cfmc-server"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "init:d1": "bash scripts/init-d1.sh",
    "init:d1:local": "bash scripts/init-d1.sh --local",
    "tail": "wrangler tail --format pretty",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "@cloudflare/vitest-pool-workers": "^0.4.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "wrangler": "^4.0.0"
  },
  "comments": {
    "零依赖设计": "运行时 dependencies 为空——Workers 冷启动时间与包体积正相关, 所有功能(路由/中间件/协议编解码)均手写实现, 不引入第三方运行时依赖",
    "wrangler": "仅作为开发/部署工具链 (devDependency), 不会打包进 Worker"
  }
}
